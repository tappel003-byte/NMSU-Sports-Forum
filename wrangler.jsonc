{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nmsu-sports-forum",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nmsu-sports-forum",
      // Replace with the id printed by `wrangler d1 create nmsu-sports-forum` (see docs/DEPLOYMENT.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // R2 is optional. Without it, photos are stored in D1 (see src/worker/storage.ts).
  // Uncomment after enabling R2 and running `wrangler r2 bucket create nmsu-sports-forum-uploads`.
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "nmsu-sports-forum-uploads" }],
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "triggers": { "crons": ["*/30 * * * *", "17 9 * * *"] },
  "vars": {
    "SITE_NAME": "NMSU Sports Forum",
    "MAIL_FROM": ""
  }
  // Custom domain: add after verifying existing DNS (docs/DEPLOYMENT.md):
  // "routes": [{ "pattern": "nmsusportsforum.com", "custom_domain": true }]
}
